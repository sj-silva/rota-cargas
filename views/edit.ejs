<%- include('partials/header') %>

<h1>Editar Carga</h1>

<% if (erro) { %><p class="erro"><%= erro %></p><% } %>

<form action="/<%= carga.id %>?_method=PUT" method="POST" class="form">

  <fieldset>
    <legend>🟢 Carregamento (Origem)</legend>
    <label>Data <input type="date" name="data_carregamento" required
      value="<%= carga.data_carregamento ? carga.data_carregamento.toISOString().slice(0,10) : '' %>"></label>
    <label>Hora <input type="time" name="hora_carregamento" required value="<%= carga.hora_carregamento %>"></label>
    <label>Cidade origem <input type="text" name="cidade_origem" required value="<%= carga.cidade_origem %>"></label>
    <label>País origem <%- include('partials/select-paises', { nome: 'pais_origem', selecionado: carga.pais_origem }) %></label>
  </fieldset>

  <fieldset>
    <legend>🔴 Entrega (Destino)</legend>
    <label>Data <input type="date" name="data_entrega" required
      value="<%= carga.data_entrega ? carga.data_entrega.toISOString().slice(0,10) : '' %>"></label>
    <label>Hora <input type="time" name="hora_entrega" required value="<%= carga.hora_entrega %>"></label>
    <label>Cidade destino <input type="text" name="cidade_destino" required value="<%= carga.cidade_destino %>"></label>
    <label>País destino <%- include('partials/select-paises', { nome: 'pais_destino', selecionado: carga.pais_destino }) %></label>
  </fieldset>

  <label class="full">
    Observações
    <textarea name="observacoes" rows="4"><%= carga.observacoes || '' %></textarea>
  </label>

  <div class="form-acoes">
    <button type="submit" class="btn btn-primary">Atualizar</button>
    <a href="/" class="btn btn-cancel">Cancelar</a>
  </div>
</form>

<%- include('partials/footer') %>